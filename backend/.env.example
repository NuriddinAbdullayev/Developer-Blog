# PostgreSQL connection string (include sslmode=require for hosted databases that require TLS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devnotes?schema=public
# Generate a long random value, for example: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret
PORT=3000
# Comma-separated deployed frontend origins, e.g. https://devnotes.example.com
CORS_ORIGIN=http://localhost:5173
